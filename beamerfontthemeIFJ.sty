\mode<presentation>

\RequirePackage{iftex} %to detect if the user is compiling using XeTeX or PDFLaTeX

\ifPDFTeX
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[sfdefault]{carlito} %pdflatex does not support calibri
\RequirePackage[polish,main=english]{babel} %equivalent to polyglossia
\else
\RequirePackage{fontspec}
\setsansfont{Calibri} %XeLaTeX supports calibri
\RequirePackage{polyglossia} %equivalent to babel
\setmainlanguage{english}
\setotherlanguage{polish}
\fi



%LANGUAGE SPECIFIC TYPOGRAPHY
\RequirePackage[autostyle]{csquotes}
\RequirePackage{hyperref}
\RequirePackage{caption}
\RequirePackage{biblatex}
	


\setbeamerfont{title}{series=\bfseries, size=\fontsize{36}{40}\selectfont}
\setbeamerfont{author}{size=\fontsize{20}{22}\selectfont}
\setbeamerfont{placeAndDate}{size=\fontsize{20}{22}\selectfont}
\setbeamerfont{department}{size=\fontsize{20}{22}\selectfont}

% later slides, for example:
\setbeamerfont{frametitle}{size=\fontsize{26}{29}\selectfont}
\setbeamerfont{footer}{size=\fontsize{12}{13}\selectfont}


\renewcommand{\normalsize}{\fontsize{18}{22}\selectfont} \AtBeginDocument{\normalsize}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{18}{20}\selectfont}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{16}{18}\selectfont}
\setbeamerfont{itemize/enumerate subsubbody}{size=\fontsize{14}{16}\selectfont}


\mode<all>
