\def\insertplaceAndDate{}
\def\insertshortplaceAndDate{}

\newcommand{\placeAndDate}[2][]{
	\def\insertplaceAndDate{#2}
	\def\insertshortplaceAndDate{#1}
	\ifx\insertshortplaceAndDate\@empty
	\def\insertshortplaceAndDate{#2}   
	\fi
}


\def\insertdepartment{}
\def\insertshortdepartment{}

\newcommand{\department}[2][]{
	\def\insertdepartment{#2}
	\def\insertshortdepartment{#1}
	\ifx\insertshortdepartment\@empty
	\def\insertshortdepartment{#2}  
	\fi
}



